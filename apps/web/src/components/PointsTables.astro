---
import type { PublicPolicyView } from "../lib/policy.js";

interface Props {
  policy: PublicPolicyView;
}
const { policy } = Astro.props;
const tiers = [2, 3, 4, 5] as const;
const stages = ["semifinal", "quarterfinal", "octafinal"] as const;
function eliminationPoints(
  tier: (typeof tiers)[number],
  stage: (typeof stages)[number],
): number | "None" {
  const table = policy.tiers[tier].eliminations as Readonly<
    Partial<Record<(typeof stages)[number], number>>
  >;
  return table[stage] ?? "None";
}
---

<div class="points-ledger">
  <div class="table-wrap" role="region" aria-label="Placement points" tabindex="0">
    <table>
      <caption>Placement points by tournament tier</caption>
      <thead>
        <tr>
          <th scope="col">Place</th>
          {tiers.map((tier) => <th class="numeric" scope="col">Tier {tier}</th>)}
        </tr>
      </thead>
      <tbody>
        {policy.tiers[2].placements.map((_, index) => (
          <tr>
            <th scope="row">{index + 1}</th>
            {tiers.map((tier) => (
              <td class="numeric"><strong>{policy.tiers[tier].placements[index]}</strong></td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="table-wrap" role="region" aria-label="Elimination points" tabindex="0">
    <table>
      <caption>Elimination-round points by tournament tier</caption>
      <thead>
        <tr>
          <th scope="col">Furthest round</th>
          {tiers.map((tier) => <th class="numeric" scope="col">Tier {tier}</th>)}
        </tr>
      </thead>
      <tbody>
        {stages.map((stage) => (
          <tr>
            <th scope="row">{stage}</th>
            {tiers.map((tier) => (
              <td class="numeric">{eliminationPoints(tier, stage)}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .points-ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  caption {
    padding: 0.75rem 0.8rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 700;
    text-align: left;
  }

  tbody th {
    text-transform: capitalize;
  }

  @media (max-width: 54rem) {
    .points-ledger {
      grid-template-columns: 1fr;
    }
  }
</style>
