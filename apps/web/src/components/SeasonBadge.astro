---
interface Props {
  classification:
    | "Extemp Central official archive"
    | "Automated reconstruction"
    | "Current live race";
}
const { classification } = Astro.props;
const kind = classification.startsWith("Extemp")
  ? "archive"
  : classification.startsWith("Automated")
    ? "reconstruction"
    : "live";
---

<span class:list={["season-badge", kind]}>{classification}</span>

<style>
  .season-badge {
    display: inline-block;
    width: fit-content;
    border-left: 2px solid currentColor;
    padding-left: 0.55rem;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .archive {
    color: var(--blue);
  }

  .reconstruction {
    color: var(--burgundy);
  }

  .live {
    color: var(--green);
  }
</style>
