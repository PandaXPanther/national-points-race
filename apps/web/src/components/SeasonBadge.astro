---
interface Props {
  classification:
    | "Extemp Central official archive"
    | "Automated reconstruction"
    | "Current live race";
}
const { classification } = Astro.props;
const kind = classification.startsWith("Extemp")
  ? "archive"
  : classification.startsWith("Automated")
    ? "reconstruction"
    : "live";
---

<span class:list={["season-badge", kind]}>{classification}</span>

<style>
  .season-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    color: var(--ink-soft);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .season-badge::before {
    width: 1.15rem;
    height: 2px;
    background: currentColor;
    content: "";
  }

  .reconstruction {
    color: var(--link);
  }

  .live {
    color: var(--success);
  }
</style>
