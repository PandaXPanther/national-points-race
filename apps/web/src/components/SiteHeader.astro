---
import { currentSeasonId } from "../lib/seasons.js";
interface Props { currentId?: string; }
const { currentId = currentSeasonId() } = Astro.props;
const { pathname } = Astro.url;
const links = [
  ["Standings", "/"],
  ["History", "/history/"],
  ["Method", "/methodology/"],
  ["Archive", "/archive/"],
  ["Corrections", "/corrections/"],
] as const;

function isCurrent(href: string): boolean {
  return href === "/" ? pathname === href || pathname === "/current/" || pathname.startsWith(`/${currentId}/`) : pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="wordmark" href="/" aria-label="National Points Race home">
      <span class="npr-mark" aria-hidden="true">NPR</span>
      <span class="publication-name">National Points Race</span>
      <span class="edition">{currentId} edition</span>
    </a>
    <nav class="nav-scroll" aria-label="Primary navigation">
      <ul>
        {
          links.map(([label, href], index) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
                <span aria-hidden="true">0{index + 1}</span>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-top: 5px solid var(--ink);
    border-bottom: 1px solid var(--rule-dark);
    background: var(--paper);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: stretch;
  }

  .wordmark {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0 0.75rem;
    align-content: center;
    min-height: 5.3rem;
    color: var(--ink);
    text-decoration: none;
  }

  .npr-mark {
    grid-row: 1 / 3;
    align-self: center;
    border-bottom: 3px solid var(--link);
    font-family: var(--serif);
    font-size: 1.8rem;
    font-weight: 680;
    letter-spacing: -0.07em;
    line-height: 0.95;
  }

  .publication-name,
  .edition {
    font-size: 0.62rem;
    font-weight: 720;
    letter-spacing: 0.09em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .edition {
    color: var(--ink-soft);
    font-weight: 550;
  }

  .nav-scroll {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  nav ul {
    display: flex;
    justify-content: flex-end;
    width: max-content;
    min-width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: grid;
    align-content: center;
    min-height: 5.3rem;
    border-left: 1px solid var(--rule);
    color: var(--ink);
    padding: 0.7rem clamp(0.7rem, 1.8vw, 1.25rem);
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
  }

  nav a span {
    color: var(--ink-soft);
    font-size: 0.56rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  nav a[aria-current="page"] {
    border-bottom: 3px solid var(--link);
    color: var(--link);
  }

  @media (max-width: 48rem) {
    .header-inner {
      display: block;
    }

    .wordmark {
      width: fit-content;
      min-height: 4.5rem;
    }

    nav ul {
      justify-content: flex-start;
      min-width: max-content;
      border-top: 1px solid var(--rule);
    }

    nav a {
      min-height: 3.2rem;
      border-left: 0;
      border-right: 1px solid var(--rule);
    }
  }
</style>
