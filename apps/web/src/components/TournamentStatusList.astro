---
interface Tournament {
  readonly name: string;
  readonly tier: number;
  readonly status: string;
  readonly startAt?: string | null;
  readonly sourceUrl?: string | null;
}
interface Props {
  tournaments: readonly Tournament[];
}
const { tournaments } = Astro.props;
---

<ol class="tournament-list">
  {tournaments.map((tournament, index) => (
    <li>
      <span class="tournament-number">{String(index + 1).padStart(2, "0")}</span>
      <div>
        <span class="tier">Tier {tournament.tier}</span>
        <h3>{tournament.name}</h3>
        {tournament.startAt && <p>{tournament.startAt}</p>}
      </div>
      <div class="status-stack">
        <span class:list={["status", tournament.status]}>{tournament.status}</span>
        {tournament.sourceUrl && <a href={tournament.sourceUrl}>Official source</a>}
      </div>
    </li>
  ))}
</ol>

<style>
  .tournament-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 10rem;
    gap: 1.25rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule-dark);
  }

  h3,
  p {
    margin: 0;
  }

  p,
  a {
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .tier {
    color: var(--link);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-stack {
    min-width: 9rem;
    text-align: right;
  }

  .status {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: capitalize;
  }

  .final,
  .corrected {
    color: var(--success);
  }

  .source-unavailable,
  .not-held {
    color: var(--ink-soft);
  }

  .tournament-number {
    color: var(--ink-soft);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 35rem) {
    li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .status-stack {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
