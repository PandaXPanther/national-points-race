---
import DiscordCallout from "../components/DiscordCallout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efe4" />
    <title>{title} | National Points Race</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content"><slot /></main>
    <footer>
      <div class="shell footer-grid">
        <DiscordCallout />
        <div class="legal">
          <p>
            An independent project operated by Saras Totey. Not affiliated with
            Extemp Central, Tabroom, SpeechWire, NSDA, NCFL, or tracked tournaments.
          </p>
          <p>
            Historical NPR records are credited to Extemp Central. Current scoring
            uses the published legacy policy and auditable official sources.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  footer {
    padding: 4rem 0 2rem;
    border-top: 1px solid var(--rule);
    background: rgb(23 21 18 / 4%);
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
  }

  .legal {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .legal p {
    max-width: 42rem;
    margin: 0;
  }

  @media (max-width: 42rem) {
    .legal {
      display: block;
    }

    .legal p + p {
      margin-top: 1rem;
    }
  }
</style>
