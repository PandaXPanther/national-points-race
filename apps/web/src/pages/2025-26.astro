---
import SeasonBadge from "../components/SeasonBadge.astro";
import StandingsTable from "../components/StandingsTable.astro";
import TournamentStatusList from "../components/TournamentStatusList.astro";
import report from "../data/reconstruction/2025-26.json";
import SiteLayout from "../layouts/SiteLayout.astro";

const tournaments = report.tournaments.map((tournament) => ({
  name: tournament.name,
  tier: tournament.tier,
  status: tournament.status,
  sourceUrl: tournament.source?.url ?? null,
}));
const publishedAt = new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(new Date(report.publishedAt));
---

<SiteLayout
  title="2025-2026 Reconstruction"
  description="The automated reconstruction of the discontinued 2025-2026 National Points Race season."
>
  <header class="shell hero">
    <SeasonBadge classification="Automated reconstruction" />
    <p class="eyebrow season-line">2025-2026 season</p>
    <h1>Automated reconstruction</h1>
    <p class="dek">
      A retrospective application of the last Extemp Central policy to permitted
      official public results. This was not an official contemporaneous NPR.
    </p>
  </header>

  <section class="section summary-section">
    <div class="shell reconstruction-summary">
      <div class="champion">
        <p class="eyebrow">Reconstructed champion</p>
        <h2>Daphne Kalir-Starr</h2>
        <p class="champion-points">619 points</p>
        <p>{report.caveat}</p>
      </div>
      <dl class="audit-metrics">
        <div><dt>Policy</dt><dd>{report.policyVersion}</dd></div>
        <div><dt>Published</dt><dd>{publishedAt}</dd></div>
        <div><dt>Verified sources</dt><dd>{report.completeness.verifiedResultSources}</dd></div>
        <div><dt>Withheld sources</dt><dd>{report.completeness.withheld}</dd></div>
        <div><dt>Normalized results</dt><dd>{report.completeness.normalizedResults}</dd></div>
        <div><dt>Scored awards</dt><dd>{report.completeness.scoredAwards}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section standings-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">2025-2026 reconstructed top 100</p>
          <h2>Standings</h2>
        </div>
        <p>
          MBA points are withheld because the official export did not provide
          cumulative placements. Verifiable correction evidence can produce a new
          version.
        </p>
      </div>
      <StandingsTable standings={report.standings} />
      <p class="source-note receipt">
        Version <code>{report.standingsVersion}</code>. Identity diagnostics:
        {report.diagnostics.identity}. Rebuild diagnostics:
        {report.diagnostics.rebuild}.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Twenty-tournament audit</p>
          <h2>Source status</h2>
        </div>
        <p>
          Final means permitted official evidence was normalized and scored. Missing
          evidence is labeled rather than inferred.
        </p>
      </div>
      <TournamentStatusList tournaments={tournaments} />
    </div>
  </section>

  <section class="section">
    <div class="shell method-note">
      <div>
        <p class="eyebrow">Reconstruction method</p>
        <h2>Production pipeline, legacy policy</h2>
      </div>
      <ol>
        <li>Verify each tournament edition and official result source.</li>
        <li>Preserve bytes and the SHA-256 digest.</li>
        <li>Normalize results and resolve identities conservatively.</li>
        <li>Apply <code>legacy-2024-25-v1</code>.</li>
        <li>Publish completeness, withheld evidence, and a version hash.</li>
      </ol>
    </div>
  </section>
</SiteLayout>

<style>
  .season-line {
    margin-top: 1.4rem;
  }

  .summary-section {
    padding-top: 0;
    border-top: 0;
  }

  .reconstruction-summary {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 3rem;
    border-top: 2px solid var(--ink);
    padding-top: 1.2rem;
  }

  .champion-points {
    margin: -0.35rem 0 1rem;
    color: var(--burgundy);
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .audit-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }

  .audit-metrics div {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .audit-metrics div:nth-child(even) {
    padding-left: 1rem;
  }

  dt {
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  dd {
    margin: 0.15rem 0 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .receipt {
    margin-top: 1rem;
  }

  .method-note {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 3rem;
  }

  .method-note ol {
    margin: 0;
    padding-left: 1.25rem;
  }

  @media (max-width: 46rem) {
    .reconstruction-summary,
    .method-note {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34rem) {
    .audit-metrics {
      grid-template-columns: 1fr;
    }

    .audit-metrics div:nth-child(even) {
      padding-left: 0;
    }
  }
</style>
