---
import SeasonBadge from "../components/SeasonBadge.astro";
import StandingsTable from "../components/StandingsTable.astro";
import TournamentStatusList from "../components/TournamentStatusList.astro";
import report from "../data/reconstruction/2025-26.json";
import SiteLayout from "../layouts/SiteLayout.astro";
import { absoluteUrl } from "../lib/seo.js";

const tournaments = report.tournaments.map((tournament) => ({
  name: tournament.name,
  tier: tournament.tier,
  status: tournament.status,
  sourceUrl: tournament.source?.url ?? null,
}));
const publishedAt = new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(new Date(report.publishedAt));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "2025-26 National Points Race reconstruction",
  description:
    "A deterministic Top 100 reconstruction using permitted official tournament evidence.",
  url: absoluteUrl("/2025-26/"),
  datePublished: report.publishedAt,
  creator: { "@type": "Person", name: "Saras Totey" },
  variableMeasured: ["points", "wins", "top-three finishes", "finals"],
};
---

<SiteLayout
  title="2025-26 Reconstructed Standings"
  description="The audited Top 100 reconstruction of the 2025-26 National Points Race, led by Daphne Kalir-Starr with 619 points."
  canonicalPath="/2025-26/"
  {structuredData}
>
  <header class="reconstruction-head">
    <div class="shell">
      <div class="reconstruction-labels">
        <SeasonBadge classification="Automated reconstruction" />
        <span>2025-26 / Final</span>
      </div>
      <div class="champion-scoreline">
        <div>
          <p class="label">Reconstructed champion</p>
          <h1>Daphne<br />Kalir-Starr</h1>
        </div>
        <div class="score">
          <strong>619</strong>
          <span>points</span>
        </div>
      </div>
      <p class="reconstruction-caveat">
        Retrospective, not an official contemporaneous NPR. {report.caveat}
      </p>
      <dl class="audit-facts">
        <div><dt>Policy</dt><dd>{report.policyVersion}</dd></div>
        <div><dt>Verified sources</dt><dd>{report.completeness.verifiedResultSources} / 20</dd></div>
        <div><dt>Results</dt><dd>{report.completeness.normalizedResults}</dd></div>
        <div><dt>Awards</dt><dd>{report.completeness.scoredAwards}</dd></div>
      </dl>
    </div>
  </header>

  <section class="section standings-section">
    <div class="shell">
      <div class="standings-heading">
        <div>
          <p class="label">Reconstructed final</p>
          <h2>Top 100</h2>
        </div>
        <p>Eligible awards scored under the last published legacy policy.</p>
      </div>
      <StandingsTable standings={report.standings} seasonId="2025-26" />
      <details class="receipt">
        <summary>Version receipt</summary>
        <p>
          Published {publishedAt}. Version <code>{report.standingsVersion}</code>.
          Identity diagnostics: {report.diagnostics.identity}. Rebuild diagnostics:
          {report.diagnostics.rebuild}.
        </p>
      </details>
    </div>
  </section>

  <section class="section source-section">
    <div class="shell">
      <div class="section-heading">
        <div><p class="label">Evidence ledger</p><h2>Source status</h2></div>
        <p>Missing evidence is labeled, never inferred.</p>
      </div>
      <TournamentStatusList tournaments={tournaments} />
    </div>
  </section>
</SiteLayout>

<style>
  .reconstruction-head {
    padding-block: clamp(3rem, 7vw, 6rem) 0;
  }

  .reconstruction-labels {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .champion-scoreline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-top: 4rem;
    border-bottom: 5px solid var(--ink);
    padding-bottom: 1.5rem;
  }

  .champion-scoreline h1 {
    max-width: 10ch;
    font-size: clamp(4.2rem, 10vw, 9rem);
  }

  .score {
    display: flex;
    align-items: baseline;
    color: var(--link);
  }

  .score strong {
    font-family: var(--serif);
    font-size: clamp(6rem, 17vw, 14rem);
    font-weight: 650;
    letter-spacing: -0.08em;
    line-height: 0.7;
  }

  .score span {
    margin-left: 0.5rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .reconstruction-caveat {
    max-width: 58rem;
    margin: 1rem 0 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  .audit-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 2.75rem 0 0;
    border-top: 1px solid var(--rule-dark);
  }

  .audit-facts div {
    padding: 0.7rem 1rem 0.7rem 0;
  }

  .audit-facts div + div {
    border-left: 1px solid var(--rule);
    padding-left: 1rem;
  }

  .audit-facts dt {
    color: var(--ink-soft);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .audit-facts dd {
    margin: 0.15rem 0 0;
    font-family: var(--serif);
    font-size: 1.2rem;
    overflow-wrap: anywhere;
  }

  .standings-section {
    border-top-color: var(--ink);
  }

  .standings-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.25rem;
  }

  .standings-heading h2,
  .standings-heading p {
    margin-bottom: 0;
  }

  .standings-heading > p {
    max-width: 28rem;
    color: var(--ink-soft);
  }

  .receipt {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 0.72rem;
  }

  .receipt summary {
    width: fit-content;
    color: var(--link);
    cursor: pointer;
    font-weight: 700;
  }

  .receipt p {
    max-width: var(--measure);
    overflow-wrap: anywhere;
  }

  .source-section {
    padding-bottom: 6rem;
  }

  @media (max-width: 52rem) {
    .champion-scoreline {
      grid-template-columns: minmax(0, 1fr);
    }

    .score {
      justify-content: flex-end;
    }

    .audit-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .champion-scoreline h1 {
      font-size: clamp(3.8rem, 19vw, 5.8rem);
    }

    .score strong {
      font-size: clamp(5.5rem, 32vw, 8.5rem);
    }

    .audit-facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .audit-facts div + div {
      border-top: 1px solid var(--rule);
      border-left: 0;
      padding-left: 0;
    }

    .standings-heading {
      align-items: start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
