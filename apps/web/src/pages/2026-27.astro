---
import SeasonBadge from "../components/SeasonBadge.astro";
import MbaSubmissionForm from "../components/MbaSubmissionForm.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="2026-2027 Current Race"
  description="The current live National Points Race for the 2026-2027 season."
>
  <header class="shell hero">
    <SeasonBadge classification="Current live race" />
    <p class="eyebrow season-line">2026-2027 season</p>
    <h1>Current standings</h1>
    <p class="dek">
      The season is initialized under policy <code>npr-2026-27-v1</code>.
      Standings remain empty until eligible final evidence is published and
      verified.
    </p>
  </header>

  <section class="section">
    <div class="shell stats-grid" aria-label="Current season summary">
      <div class="stat"><span>Status</span><strong>Initialized</strong></div>
      <div class="stat"><span>Tracked tournaments</span><strong>21</strong></div>
      <div class="stat"><span>Scored events</span><strong>0</strong></div>
      <div class="stat"><span>Public limit</span><strong>Top 100</strong></div>
    </div>
  </section>

  <section class="section">
    <div class="shell current-notes">
      <article>
        <p class="eyebrow">Current policy addition</p>
        <h2>Arizona State HDSHC Invitational</h2>
        <p>
          The ASU tournament is tracked as a Tier 4 event beginning this season.
          January discovery uses verified Arizona State University organizer
          evidence and the annual Tabroom lineage. It remains in later seasons until
          a published policy replaces it.
        </p>
        <p>
          <a href="/methodology/">Review the 21-tournament policy</a>
        </p>
      </article>
      <article>
        <p class="eyebrow">Publication rule</p>
        <h2>No preseason points</h2>
        <p>
          The race does not infer results from registrations, invitations, or prior
          seasons. The first standings version will follow eligible final evidence
          from a tracked tournament.
        </p>
        <p><a href="/2026-27/tournaments/">View the tournament audit</a></p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <MbaSubmissionForm seasonId="2026-27" />
    </div>
  </section>
</SiteLayout>

<style>
  .season-line {
    margin-top: 1.4rem;
  }

  .current-notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .current-notes article {
    border-top: 2px solid var(--rule-dark);
    padding-top: 1rem;
  }

  @media (max-width: 44rem) {
    .current-notes {
      grid-template-columns: 1fr;
    }
  }
</style>
