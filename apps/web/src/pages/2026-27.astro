---
import MbaSubmissionForm from "../components/MbaSubmissionForm.astro";
import SeasonBadge from "../components/SeasonBadge.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getPolicyView } from "../lib/policy.js";
import { absoluteUrl } from "../lib/seo.js";

const policy = getPolicyView();
const reviewedLineages = [
  { id: "nietoc", name: "NIETOC" },
  { id: "stanford", name: "Stanford" },
  { id: "james-logan-mlk", name: "James Logan" },
  { id: "asu-hdshc-invitational", name: "ASU" },
] as const;
const reviewedTiers = reviewedLineages.map((reviewed) => {
  const tournament = policy.tournaments.find(({ id }) => id === reviewed.id);
  if (tournament === undefined) {
    throw new Error(`Missing current policy lineage: ${reviewed.id}`);
  }
  return { ...reviewed, tier: tournament.tier };
});
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "2026-27 National Points Race",
  description:
    "The current live National Points Race, tracking 21 national extemp tournaments and publishing the Top 100.",
  url: absoluteUrl("/2026-27/"),
  creator: { "@type": "Person", name: "Saras Totey" },
  temporalCoverage: "2026/2027",
};
---

<SiteLayout
  title="2026-27 Current Race"
  description="The current National Points Race for 2026-27, tracking 21 tournaments and publishing an audited Top 100."
  canonicalPath="/2026-27/"
  {structuredData}
>
  <header class="current-head">
    <div class="shell current-title">
      <div>
        <SeasonBadge classification="Current live race" />
        <p class="label">2026-27 / Current edition</p>
        <h1>The scorebook is open.</h1>
      </div>
      <p class="edition-number">27</p>
    </div>
    <dl class="shell preseason-register" aria-label="Current season summary">
      <div><dt>Status</dt><dd>Preseason</dd></div>
      <div><dt>Tournaments</dt><dd>21</dd></div>
      <div><dt>Scored</dt><dd>0</dd></div>
      <div><dt>Published</dt><dd>Top 100</dd></div>
      <div><dt>Policy</dt><dd>{policy.version}</dd></div>
    </dl>
  </header>

  <section class="section preseason-note">
    <div class="shell season-notes">
      <article>
        <p class="label">Reviewed for 2026-27</p>
        <h2>Four placements, one ledger.</h2>
        <ul class="reviewed-tiers">
          {reviewedTiers.map(({ name, tier }) => (
            <li><span>{name}</span><strong>Tier {tier}</strong></li>
          ))}
        </ul>
        <a href="/methodology/#tournaments">See all 21 tournaments</a>
      </article>
      <aside>
        <span>Publication rule</span>
        <p>No points appear before a tracked tournament publishes verified finals.</p>
        <a href="/2026-27/tournaments/">Tournament audit</a>
      </aside>
    </div>
  </section>

  <section class="section mba-section">
    <div class="shell">
      <MbaSubmissionForm seasonId="2026-27" />
    </div>
  </section>
</SiteLayout>

<style>
  .current-head {
    padding-top: clamp(3rem, 8vw, 7rem);
  }

  .current-title {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
  }

  .current-title .label {
    margin-top: 2.8rem;
  }

  .current-title h1 {
    max-width: 11ch;
  }

  .edition-number {
    margin: 0;
    color: var(--link);
    font-family: var(--serif);
    font-size: clamp(9rem, 25vw, 21rem);
    font-weight: 650;
    letter-spacing: -0.1em;
    line-height: 0.62;
  }

  .preseason-register {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1.5fr;
    margin-top: clamp(3rem, 7vw, 7rem);
    border-top: 5px solid var(--ink);
    border-bottom: 1px solid var(--rule-dark);
  }

  .preseason-register div {
    padding: 0.75rem 1rem 0.8rem 0;
  }

  .preseason-register div + div {
    border-left: 1px solid var(--rule);
    padding-left: 1rem;
  }

  .preseason-register dt {
    color: var(--ink-soft);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .preseason-register dd {
    margin: 0.15rem 0 0;
    font-family: var(--serif);
    font-size: 1.25rem;
    overflow-wrap: anywhere;
  }

  .preseason-note {
    border-top: 0;
  }

  .season-notes {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .season-notes article {
    max-width: 43rem;
  }

  .season-notes article h2 {
    font-size: clamp(2.4rem, 5vw, 4.7rem);
  }

  .reviewed-tiers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 36rem;
    margin: 1.5rem 0;
    padding: 0;
    border-top: 1px solid var(--rule-dark);
    list-style: none;
  }

  .reviewed-tiers li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1rem 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.8rem;
  }

  .reviewed-tiers li:nth-child(even) {
    border-left: 1px solid var(--rule);
    padding-left: 1rem;
  }

  .season-notes aside {
    align-self: end;
    border-top: 2px solid var(--ink);
    padding-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .season-notes aside span {
    color: var(--ink);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mba-section {
    padding-bottom: 7rem;
    background: var(--paper-raised);
  }

  @media (max-width: 52rem) {
    .current-title {
      grid-template-columns: minmax(0, 1fr);
    }

    .edition-number {
      justify-self: end;
    }

    .preseason-register {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .season-notes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 34rem) {
    .edition-number {
      font-size: 11rem;
    }

    .preseason-register {
      grid-template-columns: minmax(0, 1fr);
    }

    .preseason-register div + div {
      border-top: 1px solid var(--rule);
      border-left: 0;
      padding-left: 0;
    }

    .reviewed-tiers {
      grid-template-columns: minmax(0, 1fr);
    }

    .reviewed-tiers li:nth-child(even) {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
