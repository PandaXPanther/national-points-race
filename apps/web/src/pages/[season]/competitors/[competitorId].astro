---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getCompetitor, type ApiContext } from "../../../lib/api.js";

const seasonId = Astro.params.season ?? "";
const competitorId = Astro.params.competitorId ?? "";
const apiBase = import.meta.env.PUBLIC_API_BASE_URL;
let competitor = null;
if (apiBase) {
  const context: ApiContext = { baseUrl: apiBase };
  competitor = await getCompetitor(seasonId, competitorId, context).catch(
    () => null,
  );
}
---

<SiteLayout
  title={competitor ? competitor.name : "Competitor audit"}
  description="Award-level National Points Race competitor audit trail."
>
  {competitor ? (
    <>
      <header class="shell hero">
        <p class="eyebrow">Competitor audit</p>
        <h1>{competitor.name}</h1>
        <p class="dek">{competitor.school}</p>
      </header>
      <section class="section">
        <div class="shell stats-grid">
          <div class="stat"><span>Rank</span><strong>{competitor.total.rank}</strong></div>
          <div class="stat"><span>Points</span><strong>{competitor.total.points}</strong></div>
          <div class="stat"><span>Wins</span><strong>{competitor.total.wins}</strong></div>
          <div class="stat"><span>Finals</span><strong>{competitor.total.finals}</strong></div>
        </div>
      </section>
      <section class="section">
        <div class="shell">
          <div class="section-heading">
            <div><p class="eyebrow">Award provenance</p><h2>Counted results</h2></div>
          </div>
          <ol class="award-register">
            {competitor.awards.map((award) => (
              <li>
                <span>{award.division} extemp</span>
                <div>
                  <h3>{award.editionId}</h3>
                  <p><strong>{award.points} points</strong> via {award.ruleId}</p>
                </div>
                <p class="source-note">
                  <a href={award.source.url}>Official source</a><br />
                  SHA-256 {award.source.sha256.slice(0, 12)}...
                </p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </>
  ) : (
    <section class="shell hero">
      <p class="eyebrow">Competitor audit</p>
      <h1>Audit record unavailable</h1>
      <p class="dek">
        The public API has no verified competitor record at this route. No result
        is inferred.
      </p>
      <p><a href={`/${seasonId}/`}>Return to the season</a></p>
    </section>
  )}
</SiteLayout>

<style>
  .award-register {
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
    list-style: none;
  }

  .award-register li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) 13rem;
    gap: 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .award-register h3,
  .award-register p {
    margin: 0;
  }

  @media (max-width: 42rem) {
    .award-register li {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>
