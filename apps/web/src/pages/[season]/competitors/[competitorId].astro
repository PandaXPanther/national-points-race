---
import reconstruction from "../../../data/reconstruction/2025-26.json";
import standings2024 from "../../../data/history/2024-25.json";
import PlacementRecord from "../../../components/PlacementRecord.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getCompetitor, PublicApiError } from "../../../lib/api.js";
import { loadSeasonCatalog, publicApiContext, resolveSeason } from "../../../lib/seasons.js";
import { absoluteUrl } from "../../../lib/seo.js";

const seasonId = Astro.params.season ?? "";
// Astro route parameters retain URL escapes; the API client encodes a decoded ID.
let competitorId = "";
try { competitorId = decodeURIComponent(Astro.params.competitorId ?? ""); } catch { /* Malformed identities receive a 404 below. */ }
const catalog = await loadSeasonCatalog();
const record = resolveSeason(seasonId, catalog);
Astro.response.headers.set("Cache-Control", "no-cache");
let competitor = null;
let apiStatus = competitorId ? 503 : 404;
if (record?.kind === "live" && competitorId) {
  competitor = await getCompetitor(seasonId, competitorId, publicApiContext()).catch(
    (error: unknown) => { if (error instanceof PublicApiError && error.status === 404) apiStatus = 404; return null; },
  );
  if (competitor?.seasonId !== seasonId || competitor?.competitorId !== competitorId) competitor = null;
}
const reconstructedStanding =
  seasonId === "2025-26"
    ? reconstruction.standings.find(
        (standing) => standing.competitorId === competitorId || (/^\d+$/u.test(competitorId) && standing.rank === Number(competitorId)),
      )
    : seasonId === "2024-25" && /^\d+$/u.test(competitorId) ? standings2024.find((standing) => standing.rank === Number(competitorId)) : undefined;
if (!record) Astro.response.status = 404;
else if (!competitor && !reconstructedStanding) Astro.response.status = record.kind === "historical" ? 404 : apiStatus;
const displayName = competitor?.name ?? reconstructedStanding?.name;
const standingsPath = seasonId === catalog.currentSeasonId ? `/${seasonId}/` : `/archive/${seasonId}/`;
const canonicalPath = `/${seasonId}/competitors/${encodeURIComponent(competitorId)}/`;
const structuredData = displayName
  ? {
      "@context": "https://schema.org",
      "@type": "Dataset",
      name: `${displayName}, ${seasonId} NPR record`,
      description: `National Points Race score record for ${displayName}.`,
      url: absoluteUrl(canonicalPath),
    }
  : undefined;
---

<SiteLayout
  title={displayName ? `${displayName} NPR Record` : "Competitor record"}
  description={displayName ? `Tournament placements and points for ${displayName} in the ${seasonId} National Points Race.` : "National Points Race competitor results and points."}
  {canonicalPath}
  {structuredData}
  currentId={catalog.currentSeasonId}
>
  {competitor ? (
    <>
      <header class="page-head competitor-head">
        <div class="shell">
          <p class="label">Competitor record / {seasonId}</p>
          <h1>{competitor.name}</h1>
          <p class="dek">{competitor.school}</p>
          <p class="back-link"><a href={standingsPath}>Return to the standings</a></p>
        </div>
      </header>
      <section class="score-strip-section">
        <dl class="shell score-strip">
          <div><dt>Rank</dt><dd>{competitor.total.rank}</dd></div>
          <div><dt>Points</dt><dd>{competitor.total.points}</dd></div>
          <div><dt>Wins</dt><dd>{competitor.total.wins}</dd></div>
          <div><dt>Finals</dt><dd>{competitor.total.finals}</dd></div>
        </dl>
      </section>
      <PlacementRecord awards={competitor.awards} totalPoints={competitor.total.points} />
    </>
  ) : reconstructedStanding ? (
    <>
      <header class="page-head competitor-head">
        <div class="shell">
          <p class="label">{seasonId === "2025-26" ? "Reconstructed" : "Preserved"} record / {seasonId}</p>
          <h1>{reconstructedStanding.name}</h1>
          <p class="dek">{reconstructedStanding.school}</p>
          <p class="back-link"><a href={standingsPath}>Return to the standings</a></p>
        </div>
      </header>
      <section class="score-strip-section">
        <dl class="shell score-strip">
          <div><dt>Rank</dt><dd>{reconstructedStanding.rank}</dd></div>
          <div><dt>Points</dt><dd>{reconstructedStanding.points}</dd></div>
          <div><dt>Wins</dt><dd>{reconstructedStanding.wins ?? "Not published"}</dd></div>
          <div><dt>Finals</dt><dd>{reconstructedStanding.finals ?? "Not published"}</dd></div>
        </dl>
      </section>
      <section class="section">
        <div class="shell fallback-note">
          <p class="label">Published record</p>
          <h2>{seasonId === "2025-26" ? "Reconstructed" : "Preserved"} total</h2>
          <p>This archive preserves the season total. Individual placement records are not available in this archive.</p>
          {seasonId === "2025-26" ? <a href="/2025-26/">View the season's published sources</a> : <a href={`/archive/${seasonId}/`}>View the preserved season standings</a>}
        </div>
      </section>
    </>
  ) : (
    <section class="shell hero">
      <p class="label">Competitor record</p>
      <h1>{Astro.response.status === 404 ? "Audit record not found." : "Audit record temporarily unavailable."}</h1>
      <p><a href={standingsPath}>Return to the season</a></p>
    </section>
  )}
</SiteLayout>

<style>
  .competitor-head h1 {
    max-width: 14ch;
    overflow-wrap: anywhere;
  }

  .back-link { margin: 1.5rem 0 0; font-size: 0.85rem; }

  .score-strip-section {
    padding-top: 2rem;
  }

  .score-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 5px solid var(--ink);
    border-bottom: 1px solid var(--rule-dark);
  }

  .score-strip div {
    padding-block: 0.8rem;
  }

  .score-strip div + div {
    border-left: 1px solid var(--rule);
    padding-left: 1rem;
  }

  .score-strip dt {
    color: var(--ink-soft);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .score-strip dd {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    line-height: 1;
  }

  .fallback-note {
    max-width: 42rem;
  }

  @media (max-width: 48rem) {
    .score-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .score-strip {
      grid-template-columns: minmax(0, 1fr);
    }

    .score-strip div + div {
      border-top: 1px solid var(--rule);
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
