---
import TournamentStatusList from "../../../components/TournamentStatusList.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getPolicyView } from "../../../lib/policy.js";

const seasonId = Astro.params.season ?? "unknown";
const tournaments = getPolicyView().tournaments.map((tournament) => ({
  name: tournament.canonicalName,
  tier: tournament.tier,
  status: seasonId === "2026-27" ? "discovering" : "source-unavailable",
}));
---

<SiteLayout title={`${seasonId} Tournament Audit`} description="Tournament evidence and status for a National Points Race season.">
  <header class="shell hero"><p class="eyebrow">Tournament audit</p><h1>{seasonId} evidence ledger.</h1><p class="dek">Every frozen lineage remains visible, including events that are upcoming, unavailable, corrected, or not held.</p></header>
  <section class="section"><div class="shell"><TournamentStatusList {tournaments} /></div></section>
</SiteLayout>
