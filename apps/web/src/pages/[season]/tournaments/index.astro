---
import TournamentStatusList from "../../../components/TournamentStatusList.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getPolicyView } from "../../../lib/policy.js";

const seasonId = Astro.params.season ?? "unknown";
const tournaments = getPolicyView().tournaments.map((tournament) => ({
  name: tournament.canonicalName,
  tier: tournament.tier,
  status: seasonId === "2026-27" ? "discovering" : "source-unavailable",
}));
---

<SiteLayout
  title={`${seasonId} Tournament Audit`}
  description={`Evidence status for every tournament tracked in the ${seasonId} National Points Race.`}
  canonicalPath={`/${seasonId}/tournaments/`}
>
  <header class="page-head audit-head">
    <div class="shell">
      <p class="label">Tournament audit / {seasonId}</p>
      <h1>Twenty-one evidence lines.</h1>
      <p class="dek">Upcoming, unavailable, corrected, and not-held events remain visible.</p>
    </div>
  </header>
  <section class="section audit-register">
    <div class="shell"><TournamentStatusList {tournaments} /></div>
  </section>
</SiteLayout>

<style>
  .audit-head h1 {
    max-width: 14ch;
  }

  .audit-register {
    border-top: 0;
  }
</style>
