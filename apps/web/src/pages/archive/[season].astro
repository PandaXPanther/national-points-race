---
import SeasonBadge from "../../components/SeasonBadge.astro";
import StandingsTable from "../../components/StandingsTable.astro";
import { historicalSeason } from "../../data/history.js";
import standings2024 from "../../data/history/2024-25.json";
import reconstruction2025 from "../../data/reconstruction/2025-26.json";
import SiteLayout from "../../layouts/SiteLayout.astro";

const season = historicalSeason(Astro.params.season ?? "");
if (!season) {
  Astro.response.status = 404;
}
const standings =
  season?.seasonId === "2024-25"
    ? standings2024
    : season?.seasonId === "2025-26"
      ? reconstruction2025.standings
      : null;
---

<SiteLayout
  title={season ? `${season.displaySeason} Archive` : "Season not found"}
  description="An attributed National Points Race season record."
>
  {season ? (
    <>
      <header class="shell hero">
        <SeasonBadge classification={season.classification} />
        <p class="eyebrow season-line">Season record</p>
        <h1>{season.displaySeason}</h1>
        <p class="dek">{season.note}</p>
      </header>
      {season.winner && (
        <section class="section result-summary">
          <div class="shell result-row">
            <div>
              <span>Winner</span>
              <strong>{season.winner.name}</strong>
              <p>{season.winner.points} points</p>
            </div>
            {season.runnerUp && (
              <div>
                <span>Runner-up</span>
                <strong>{season.runnerUp.name}</strong>
                <p>{season.runnerUp.points} points</p>
              </div>
            )}
          </div>
        </section>
      )}
      <section class="section">
        <div class="shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Preserved record</p>
              <h2>{standings ? "Published standings" : "Original sources"}</h2>
            </div>
            <p>
              Historical facts are attributed to Extemp Central. The 2025-26 table
              is labeled as an automated reconstruction.
            </p>
          </div>
          {standings ? (
            <StandingsTable standings={standings} />
          ) : (
            <ul class="source-register">
              {season.sources.map((source) => (
                <li>
                  <span>{source.attribution}</span>
                  <div>
                    <h3>{source.title}</h3>
                    <p class="muted">Format: {source.format}</p>
                  </div>
                  <a href={source.url}>Open original source</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    </>
  ) : (
    <section class="shell hero">
      <h1>Season not found</h1>
      <p><a href="/archive/">Return to the archive</a></p>
    </section>
  )}
</SiteLayout>

<style>
  .season-line {
    margin-top: 1.4rem;
  }

  .result-summary {
    padding-top: 0;
    border-top: 0;
  }

  .result-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }

  .result-row span {
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .result-row strong {
    display: block;
    font-family: var(--serif);
    font-size: 1.75rem;
  }

  .result-row p {
    margin: 0;
  }

  .source-register {
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
    list-style: none;
  }

  .source-register li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .source-register h3,
  .source-register p {
    margin: 0;
  }

  @media (max-width: 42rem) {
    .result-row,
    .source-register li {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
  }
</style>
