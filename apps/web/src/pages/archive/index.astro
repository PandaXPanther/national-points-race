---
import SeasonBadge from "../../components/SeasonBadge.astro";
import { HISTORICAL_SEASONS } from "../../data/history.js";
import SiteLayout from "../../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Archive"
  description="Every published, reconstructed, and current National Points Race season."
>
  <header class="shell hero">
    <p class="eyebrow">Season index</p>
    <h1>National Points Race archive</h1>
    <p class="dek">
      Ten Extemp Central seasons, the 2025-26 automated reconstruction, and the
      current independently operated race.
    </p>
  </header>
  <section class="section archive-section">
    <div class="shell">
      <ol class="archive-register">
        {HISTORICAL_SEASONS.map((season) => (
          <li>
            <p class="season">{season.displaySeason}</p>
            <div class="record">
              <SeasonBadge classification={season.classification} />
              {season.winner ? (
                <p class="winner">
                  <strong>{season.winner.name}</strong>
                  <span>{season.winner.points} points</span>
                </p>
              ) : (
                <p class="muted">{season.note}</p>
              )}
            </div>
            <a href={`/archive/${season.seasonId}/`}>Open record</a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</SiteLayout>

<style>
  .archive-section {
    padding-top: 0;
    border-top: 0;
  }

  .archive-register {
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
    list-style: none;
  }

  .archive-register li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: start;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .season,
  .winner,
  .record > p {
    margin: 0;
  }

  .season {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .winner {
    display: flex;
    gap: 0.7rem;
    margin-top: 0.5rem;
  }

  .winner span {
    color: var(--ink-soft);
  }

  @media (max-width: 42rem) {
    .archive-register li {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
  }
</style>
