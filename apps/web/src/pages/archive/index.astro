---
import SeasonBadge from "../../components/SeasonBadge.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { loadSeasonCatalog, seasonStatusLabel } from "../../lib/seasons.js";
const catalog = await loadSeasonCatalog();
Astro.response.headers.set("Cache-Control", "no-cache");
---

<SiteLayout
  title="National Points Race Archive"
  description="Preserved historical records and the latest published results of previous autonomous National Points Race seasons."
  canonicalPath="/archive/"
  currentId={catalog.currentSeasonId}
>
  <header class="page-head">
    <div class="shell archive-head">
      <p class="label">Season archive</p>
      <h1>Every season, on record.</h1>
      <p class="dek">Original records, reconstructed proof, completed and provisional past seasons.</p>
    </div>
  </header>
  <section class="section archive-section">
    <div class="shell">
      {!catalog.available && <p role="status">Live season archive temporarily unavailable. The preserved historical records below remain accessible.</p>}
      <ol class="archive-register">
        {catalog.archives.map((season, index) => (
          <li>
            <span class="issue">{String(index + 1).padStart(2, "0")}</span>
            <p class="season">{season.displaySeason}</p>
            <div class="record">
              <SeasonBadge classification={season.classification} />
              {season.kind === "live" && <p class="muted">{seasonStatusLabel(season.status)}</p>}
              {season.champions.length ? (
                <>
                  {season.kind === "live" && <p class="muted">{season.champions.length > 1 ? "Co-champions" : "Champion"}</p>}
                  {season.champions.map((champion) => <p class="winner"><strong>{champion.name}</strong><span>{champion.points} points</span></p>)}
                </>
              ) : (
                <p class="muted">{season.status === "provisional" ? "Awaiting finalization. No champion designated." : season.status === "unpublished" ? "Awaiting publication. No champion designated." : "No champion designated in this publication."}</p>
              )}
            </div>
            <a href={`/archive/${season.seasonId}/`}>Open</a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</SiteLayout>

<style>
  .archive-head {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0 2rem;
  }

  .archive-head h1,
  .archive-head .dek {
    grid-column: 2;
  }

  .archive-section {
    border-top: 0;
  }

  .archive-register {
    margin: 0;
    padding: 0;
    border-top: 5px solid var(--ink);
    list-style: none;
  }

  .archive-register li {
    display: grid;
    grid-template-columns: 3rem 9rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule-dark);
  }

  .issue {
    color: var(--ink-soft);
    font-size: 0.62rem;
  }

  .season,
  .winner,
  .record > p {
    margin: 0;
  }

  .season {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 650;
  }

  .winner {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.35rem;
  }

  .winner span,
  .record .muted {
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  @media (max-width: 46rem) {
    .archive-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .archive-head h1,
    .archive-head .dek {
      grid-column: 1;
    }

    .archive-register li {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      gap: 0.5rem 0.75rem;
    }

    .archive-register .record {
      grid-column: 2 / 4;
    }
  }
</style>
