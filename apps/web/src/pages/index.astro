---
import SeasonBadge from "../components/SeasonBadge.astro";
import StandingsTable from "../components/StandingsTable.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { loadSeasonCatalog, loadLivePublication, resolveSeason, seasonStatusLabel } from "../lib/seasons.js";
import { absoluteUrl, SITE_NAME } from "../lib/seo.js";

const catalog = await loadSeasonCatalog();
const currentId = catalog.currentSeasonId;
const record = resolveSeason(currentId, catalog)!;
const publication = await loadLivePublication(record);
const standings = publication.standings;
const summary = catalog.current?.summary;
const latestArchive = catalog.archives[0];
Astro.response.headers.set("Cache-Control", "no-cache");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: absoluteUrl("/"),
  description: "The independent National Points Race for high school extemporaneous speaking.",
};
const updated = standings ? new Date(standings.publishedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }) : null;
---

<SiteLayout title="National Points Race" description="See the current national extemp standings, tournament results, scoring rules, and past seasons." {structuredData} {currentId}>
  <header class="home-intro shell">
    <h1>National Points Race</h1>
    <p>National rankings for high school extemp.</p>
  </header>

  <section class="current-race shell" aria-labelledby="current-standings">
    <div class="race-heading">
      <div>
        <p class="sr-only">Current live race</p>
        <h2 id="current-standings">{currentId} standings</h2>
      </div>
      <a class="primary-link" href={`/${currentId}/`}>View full standings <span aria-hidden="true">→</span></a>
    </div>
    <nav class="race-links" aria-label="Current race resources">
      <a href={`/${currentId}/tournaments/`}>Tournaments &amp; results</a>
      <a href="/methodology/">Scoring rules</a>
      <a href="/archive/">Past seasons</a>
    </nav>
    {publication.state === "published" && standings ? (
      <>
        <p class="race-status">
          <strong>{summary ? `${summary.scoredTournamentCount} scored ${summary.scoredTournamentCount === 1 ? "tournament" : "tournaments"}` : "Verified results"}</strong>
          <span>{standings.standings.length} ranked competitors</span>
          <span>{seasonStatusLabel(standings.status)}</span>
          <span>Updated <time datetime={standings.publishedAt}>{updated}</time></span>
        </p>
        {standings.standings.length ? <StandingsTable standings={standings.standings.slice(0, 10)} seasonId={currentId} compact /> : <p>No competitors have been scored yet.</p>}
        {standings.standings.length > 10 && <p class="more-standings"><a href={`/${currentId}/`}>See all {standings.standings.length} competitors</a></p>}
      </>
    ) : publication.state === "unpublished" ? (
      <div class="race-message" role="status"><h3>Waiting for the first results</h3><p>Standings will appear after an eligible tournament publishes verified final results. See <a href={`/${currentId}/tournaments/`}>tracked tournaments and their status</a>.</p></div>
    ) : (
      <div class="race-message" role="status"><h3>Standings temporarily unavailable</h3><p>We couldn’t load the current standings. Please try again shortly. <a href={`/${currentId}/tournaments/`}>Check tournament results</a> or <a href="/archive/">browse past seasons</a>.</p></div>
    )}
  </section>

  <section class="past-seasons shell" aria-labelledby="past-seasons">
    <div><h2 id="past-seasons">Past seasons</h2><p>Browse previous standings and the original Extemp Central records.</p></div>
    <a href="/archive/">Browse all seasons <span aria-hidden="true">→</span></a>
    {latestArchive && <details class="latest-season"><summary>{latestArchive.seasonId} season record</summary><SeasonBadge classification={latestArchive.classification} />{latestArchive.champions.length ? <p>{latestArchive.champions.map((champion) => `${champion.name}: ${champion.points} points`).join(" · ")}</p> : <p>Awaiting finalization. {seasonStatusLabel(latestArchive.status)}. No champion has been designated.</p>}<a href={`/archive/${latestArchive.seasonId}/`}>View {latestArchive.seasonId} standings</a></details>}
  </section>
</SiteLayout>

<style>
  .home-intro { padding-block: 2rem 1.5rem; }
  .home-intro h1 { max-width: none; font-size: clamp(2.1rem, 4.5vw, 3.5rem); }
  .home-intro p { color: var(--ink-soft); max-width: 48rem; margin-bottom: 0; }
  .current-race { padding-block: 1.5rem 2.5rem; border-top: 3px solid var(--ink); }
  .race-heading { display: flex; gap: 1rem; justify-content: space-between; align-items: center; }
  .race-heading h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); margin-bottom: 0; }
  .primary-link { display: inline-flex; justify-content: center; align-items: center; gap: 1rem; padding: 0.8rem 1rem; background: var(--link); color: var(--paper-raised); font-weight: 700; text-decoration: none; }
  .primary-link:hover { text-decoration: underline; }
  .race-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-block: 1rem; }
  .race-links a { padding-block: 0.5rem; font-weight: 650; }
  .race-status { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; padding-block: 0.8rem; border-block: 1px solid var(--rule); color: var(--ink-soft); font-size: 0.85rem; }
  .race-status strong { color: var(--ink); }
  .race-message { border-left: 3px solid var(--rule-dark); padding: 1rem 1.25rem; margin-top: 1.5rem; }
  .race-message h3 { font-size: 1.5rem; }
  .race-message p { margin-bottom: 0; max-width: 45rem; }
  .more-standings { margin-bottom: 0; }
  .past-seasons { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: center; border-top: 1px solid var(--rule-dark); padding-block: 1.5rem 2rem; }
  .past-seasons h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .past-seasons p { color: var(--ink-soft); margin: 0; font-size: 0.9rem; }
  .latest-season { grid-column: 1 / -1; font-size: 0.9rem; }
  .latest-season summary { cursor: pointer; color: var(--link); padding-block: 0.5rem; }
  .latest-season p { margin-block: 0.5rem; }
  @media (max-width: 40rem) {
    .home-intro { padding-block: 1rem; }
    .current-race { padding-top: 1rem; }
    .race-heading { align-items: start; flex-direction: column; }
    .primary-link { width: 100%; }
    .race-links { gap: 0.25rem 1rem; font-size: 0.85rem; margin-block: 0.5rem; }
    .past-seasons { grid-template-columns: minmax(0, 1fr); }
  }
</style>
